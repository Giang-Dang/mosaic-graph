<Project>

  <!-- Central package management. Every HotChocolate package is pinned to one
       exact version on purpose: a book cannot afford a patch release changing
       generated code between chapters. Bumping the version is a deliberate act
       that ends with re-running scripts/verify.ps1. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <HotChocolateVersion>16.6.0</HotChocolateVersion>

    <!-- Npgsql 10.0.3's net10.0 group requires Microsoft.EntityFrameworkCore
         in [10.0.4, 11.0.0), so 10.0.0 does not resolve. 10.0.10 is the latest
         stable in that band. -->
    <EntityFrameworkVersion>10.0.10</EntityFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="HotChocolate.AspNetCore" Version="$(HotChocolateVersion)" />
    <PackageVersion Include="HotChocolate.AspNetCore.CommandLine" Version="$(HotChocolateVersion)" />
    <PackageVersion Include="HotChocolate.Types.Analyzers" Version="$(HotChocolateVersion)" />
    <PackageVersion Include="HotChocolate.Data" Version="$(HotChocolateVersion)" />
    <PackageVersion Include="HotChocolate.Data.EntityFramework" Version="$(HotChocolateVersion)" />

    <!-- Chapter 5 turns on subscriptions. The in-memory provider ships as its
         own package rather than inside HotChocolate.AspNetCore, and it is the
         only provider that needs no infrastructure. Redis, NATS and Postgres
         providers exist for the multi-instance case chapter 14 deals with. -->
    <PackageVersion Include="HotChocolate.Subscriptions.InMemory" Version="$(HotChocolateVersion)" />

    <!-- Chapter 7's federated-wire sample, and since chapter 12 all six real
         subgraphs. -->
    <PackageVersion Include="HotChocolate.ApolloFederation" Version="$(HotChocolateVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EntityFrameworkVersion)" />

    <!-- Chapter 12. Mosaic.ServiceDefaults holds the DbCommandInterceptor that
         counts statements, and an interceptor is a relational concept: it lives
         in Microsoft.EntityFrameworkCore.Relational, not in the core package.
         The services never reference this directly - the Npgsql provider brings
         it in - but the shared library has no provider and must ask for it. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EntityFrameworkVersion)" />

    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
