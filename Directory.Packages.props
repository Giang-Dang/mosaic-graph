<Project>

  <!-- Central package management. Every HotChocolate package is pinned to one
       exact version on purpose: a book cannot afford a patch release changing
       generated code between chapters. Bumping the version is a deliberate act
       that ends with re-running scripts/verify.ps1. -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <HotChocolateVersion>16.6.0</HotChocolateVersion>

    <!-- Npgsql 10.0.3's net10.0 group requires Microsoft.EntityFrameworkCore
         in [10.0.4, 11.0.0), so 10.0.0 does not resolve. 10.0.10 is the latest
         stable in that band. -->
    <EntityFrameworkVersion>10.0.10</EntityFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="HotChocolate.AspNetCore" Version="$(HotChocolateVersion)" />
    <PackageVersion Include="HotChocolate.AspNetCore.CommandLine" Version="$(HotChocolateVersion)" />
    <PackageVersion Include="HotChocolate.Types.Analyzers" Version="$(HotChocolateVersion)" />
    <PackageVersion Include="HotChocolate.Data" Version="$(HotChocolateVersion)" />
    <PackageVersion Include="HotChocolate.Data.EntityFramework" Version="$(HotChocolateVersion)" />

    <!-- Chapter 5 turns on subscriptions. The in-memory provider ships as its
         own package rather than inside HotChocolate.AspNetCore, and it is the
         only provider that needs no infrastructure. Redis, NATS and Postgres
         providers exist for the multi-instance case chapter 14 deals with. -->
    <PackageVersion Include="HotChocolate.Subscriptions.InMemory" Version="$(HotChocolateVersion)" />

    <!-- Chapter 7's federated-wire sample, and since chapter 12 all six real
         subgraphs. -->
    <PackageVersion Include="HotChocolate.ApolloFederation" Version="$(HotChocolateVersion)" />

    <!-- Chapter 15. Two packages, and the split between them is the chapter's
         subject rather than a packaging detail.

         HotChocolate.ApolloFederation, already above, is what emits
         @authenticated and @requiresScopes into a subgraph's published schema.
         Those directives are read by the router and enforced there; the
         package's own project file references HotChocolate.Core and nothing
         else, so nothing it emits can enforce anything locally.

         HotChocolate.AspNetCore.Authorization is the other half: [Authorize],
         the @authorize directive, and the middleware that actually refuses a
         field. It knows nothing about federation. A field that has to be
         refused both at the router and at its own service is declared twice,
         with two attributes from two packages, and no compiler relates them. -->
    <PackageVersion Include="HotChocolate.AspNetCore.Authorization" Version="$(HotChocolateVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chapter 15. The token itself. Mosaic signs with a symmetric key held in
         MOSAIC_JWT_SECRET rather than standing up an identity provider: the
         router's JWKS block takes either, the rest of the chapter is identical
         under both, and an OAuth server is a book of its own. 10.0.10 is the
         same band as the Entity Framework pin above. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chapter 14. The official NATS client, used by Reviews to publish one
         message per accepted review. Note which side of the graph this is on:
         nothing in Mosaic subscribes to NATS, because the router does that
         itself and the subgraph that declares the field is a schema file with
         no process behind it. NATS.Client.Hosting is the DI half and ships as
         a separate package from the client itself. -->
    <PackageVersion Include="NATS.Net" Version="3.1.0" />
    <PackageVersion Include="NATS.Client.Hosting" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EntityFrameworkVersion)" />

    <!-- Chapter 12. Mosaic.ServiceDefaults holds the DbCommandInterceptor that
         counts statements, and an interceptor is a relational concept: it lives
         in Microsoft.EntityFrameworkCore.Relational, not in the core package.
         The services never reference this directly - the Npgsql provider brings
         it in - but the shared library has no provider and must ask for it. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EntityFrameworkVersion)" />

    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
