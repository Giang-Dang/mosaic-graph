<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Target framework, nullability, implicit usings and LangVersion all come
       from Directory.Build.props at the repository root. Package versions come
       from Directory.Packages.props, so no Version attributes here.

       Sdk.Web rather than Sdk because one of the five cases calls
       AddAuthorization(), which needs the ASP.NET Core authorization services.
       Nothing here starts a web server: every case builds a request executor in
       process and executes against it directly, because four of the five facts
       are about what happens before or instead of a response. -->

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" />
    <PackageReference Include="HotChocolate.Types.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
