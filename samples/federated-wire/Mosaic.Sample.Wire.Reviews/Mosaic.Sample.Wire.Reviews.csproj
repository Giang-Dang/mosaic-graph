<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Target framework, nullability, implicit usings and LangVersion all come
       from Directory.Build.props at the repository root. Package versions come
       from Directory.Packages.props, so no Version attributes here. -->

  <ItemGroup>
    <!-- Both subgraphs log the wire the same way, and one copy of that
         configuration is worth a linked file. Nothing else is shared. -->
    <Compile Include="../WireLogging.cs" Link="WireLogging.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" />
    <PackageReference Include="HotChocolate.ApolloFederation" />
    <PackageReference Include="HotChocolate.Types.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
