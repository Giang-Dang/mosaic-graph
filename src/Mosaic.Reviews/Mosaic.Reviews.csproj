<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Target framework, nullability, implicit usings and LangVersion all come
       from Directory.Build.props. Package versions come from
       Directory.Packages.props.

       This list is the same one Mosaic.Catalog carries, which is the point:
       six subgraphs that build the same way are six subgraphs one team can
       operate. What differs between them is the domain, not the platform. -->

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="HotChocolate.AspNetCore.CommandLine" />
    <PackageReference Include="HotChocolate.ApolloFederation" />
    <PackageReference Include="HotChocolate.Data" />
    <PackageReference Include="HotChocolate.Data.EntityFramework" />
    <PackageReference Include="HotChocolate.Subscriptions.InMemory" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="HotChocolate.Types.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The request timeline, the two counters, the snake_case convention and
         the block of builder calls that makes this service composable with the
         other five. Chapter 12 created this project; before it, every one of
         those lived in Mosaic.Api and only Mosaic.Api had them. -->
    <ProjectReference Include="..\Mosaic.ServiceDefaults\Mosaic.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>