{
  "name": "mosaic-graph",
  "version": "0.0.0",
  "private": true,
  "description": "Verification harness for the Mosaic GraphQL service. The service itself is .NET; node is here to run the Postman collections, to compose the supergraph since chapter 7, and to run chapter 9's composition cases.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "verify": "pwsh scripts/verify.ps1",
    "verify:postman": "newman run postman/mosaic-federation.postman_collection.json --environment postman/mosaic-federation.local.postman_environment.json --bail",
    "verify:composition": "node scripts/composition-cases.mjs",
    "compose": "wgc router compose -i federation/mosaic.yaml -o federation/supergraph.json"
  },
  "devDependencies": {
    "newman": "6.2.2",
    "wgc": "0.129.7"
  }
}
